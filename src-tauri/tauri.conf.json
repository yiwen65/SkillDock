{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkillDock",
  "version": "0.3.2",
  "identifier": "dev.skilldock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/skilldock.desktop.in"
      },
      "rpm": {
        "desktopTemplate": "linux/skilldock.desktop.in"
      }
    },
    "targets": "all"
  }
}
