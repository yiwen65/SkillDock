{
  "name": "skilldock",
  "private": true,
  "version": "0.3.2",
  "description": "Local-first Git workspace and symlink installer for AI agent skills across Claude Code, Codex, and custom agents.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "keywords": [
    "ai-agent-skills",
    "agent-skills",
    "claude-code",
    "codex",
    "skill-manager",
    "skill-installer",
    "symlink",
    "git-workspace",
    "tauri",
    "desktop-app"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiwen65/SkillDock.git"
  },
  "bugs": {
    "url": "https://github.com/yiwen65/SkillDock/issues"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev-entry": "node scripts/install-dev-desktop-entry.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "npm run desktop:dev-entry && tauri dev --features desktop",
    "tauri:build": "tauri build --features desktop",
    "e2e": "playwright test",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "marked": "^18.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.15.0",
    "prettier": "^3.8.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.13"
  }
}
